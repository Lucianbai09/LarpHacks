# Percent-encode special characters in the password (@ becomes %40).
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/larphacks

# A separate database for the automated tests, which wipe it on every run. Its name must end in _test.
TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/larphacks_test

# Signs login sessions and email links. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=YOUR_SECRET_KEY

# When blank, accounts still work but no emails are sent, so confirmation and reset links go nowhere.
# The README explains how to get this free URL. Treat it like a password.
EMAIL_WEBHOOK_URL=

# Cloudflare's public test keys, which always pass and work anywhere. Use real ones on Render (see the README).
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
